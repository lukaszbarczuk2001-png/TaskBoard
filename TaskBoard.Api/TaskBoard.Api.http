@TaskBoard.Api_HostAddress = https://localhost:7280

### Register a new user
POST {{TaskBoard.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "lukasz@example.com",
  "password": "P@ssw0rd!123"
}

### Log in (named 'login': later requests read its accessToken, no copy/paste)
# @name login
POST {{TaskBoard.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{ 
  "email": "lukasz@example.com",
  "password": "P@ssw0rd!123"
}


### List projects (requires auth)
GET {{TaskBoard.Api_HostAddress}}/api/projects
Authorization: Bearer {{login.response.body.$.accessToken}}

### Create a project (requires auth) (named 'createProject')
# @name createProject
POST {{TaskBoard.Api_HostAddress}}/api/projects
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "key": "DEMO",
  "name": "Demo project",
  "description": "Pierwszy projekt testowy"
}


### List issues for the project (requires auth)
GET {{TaskBoard.Api_HostAddress}}/api/projects/{{createProject.response.body.$.id}}/issues
Authorization: Bearer {{login.response.body.$.accessToken}}

### Create an issue (requires auth) (named 'createIssue')
# @name createIssue
POST {{TaskBoard.Api_HostAddress}}/api/projects/{{createProject.response.body.$.id}}/issues
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "title": "Set up CI pipeline",
  "description": "Add a GitHub Actions workflow that builds and tests on push",
  "priority": "High",
  "type": "Task"
}


### Get a single issue (requires auth)
GET {{TaskBoard.Api_HostAddress}}/api/projects/{{createProject.response.body.$.id}}/issues/{{createIssue.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Move an issue to InProgress (requires auth; same call the Kanban drag-and-drop will make)
PATCH {{TaskBoard.Api_HostAddress}}/api/projects/{{createProject.response.body.$.id}}/issues/{{createIssue.response.body.$.id}}/status
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "status": "InProgress"
}

### Update an issue's details (requires auth)
PUT {{TaskBoard.Api_HostAddress}}/api/projects/{{createProject.response.body.$.id}}/issues/{{createIssue.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "title": "Set up CI pipeline (GitHub Actions)",
  "description": "Add a GitHub Actions workflow that builds and tests on push",
  "priority": "High",
  "type": "Task"
}

### Delete an issue (requires auth)
DELETE {{TaskBoard.Api_HostAddress}}/api/projects/{{createProject.response.body.$.id}}/issues/{{createIssue.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
