@inherits LayoutComponentBase
@implements IDisposable
@inject AuthTokenService Auth
@inject TaskBoardApiClient Api
@inject ProjectsState Projects
@inject NavigationManager Nav

<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="tb-appbar">
        @if (Auth.IsAuthenticated)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.MenuOpen" Color="Color.Inherit" Edge="Edge.Start" Size="Size.Small"
                           OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Toggle menu" />
        }
        @if (!Auth.IsAuthenticated || !_drawerOpen)
        {
            <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Class="tb-brand ml-2">
                <span class="tb-logo"><MudIcon Icon="@Icons.Material.Filled.ViewKanban" Size="Size.Small" /></span>
                <span class="tb-brand-name">TaskBoard</span>
            </MudLink>
        }
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           Color="Color.Inherit" Size="Size.Small" OnClick="() => _isDarkMode = !_isDarkMode" aria-label="Toggle theme" />
        </MudTooltip>
        @if (Auth.IsAuthenticated)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudAvatar Size="Size.Small" Color="@UiHelpers.ColorFor(Auth.Email)" Class="ml-3 tb-avatar" Style="cursor:pointer">
                        @UiHelpers.Initials(Auth.Email)
                    </MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.caption" Class="px-4 py-2" Color="Color.Secondary">@Auth.Email</MudText>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SignOut">Sign out</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    @if (Auth.IsAuthenticated)
    {
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Never" Class="tb-drawer">
            <div class="tb-drawer-header">
                <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Class="tb-brand">
                    <span class="tb-logo"><MudIcon Icon="@Icons.Material.Filled.ViewKanban" Size="Size.Small" /></span>
                    <span class="tb-brand-name">TaskBoard</span>
                </MudLink>
            </div>
            <MudNavMenu Class="tb-nav">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">All projects</MudNavLink>
                <div class="tb-nav-section">Projects</div>
                @if (!Projects.Loaded && Projects.Error is null)
                {
                    <MudSkeleton Height="28px" Class="mx-3 my-1" />
                    <MudSkeleton Height="28px" Class="mx-3 my-1" />
                }
                @foreach (var project in Projects.Projects)
                {
                    <MudNavLink Href="@($"/projects/{project.Id}")" Match="NavLinkMatch.Prefix">
                        <span class="tb-project-item">
                            <span class="tb-project-badge" style="background:@UiHelpers.ColorHex(project.Key)">@project.Key[..1]</span>
                            <span class="text-truncate">@project.Name</span>
                        </span>
                    </MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>
    }

    <MudMainContent Class="tb-main">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="tb-page py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode;
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
            }
        },
        PaletteLight = new PaletteLight
        {
            Primary = "#5E6AD2",
            Secondary = "#6B7280",
            Tertiary = "#8B5CF6",
            Background = "#FCFCFD",
            BackgroundGray = "#F4F5F7",
            Surface = "#FFFFFF",
            AppbarBackground = "#FCFCFD",
            AppbarText = "#16181D",
            DrawerBackground = "#F7F7F8",
            DrawerText = "#3C4049",
            DrawerIcon = "#6B7280",
            TextPrimary = "#16181D",
            TextSecondary = "#6B7280",
            ActionDefault = "#6B7280",
            Success = "#1F9D6B",
            Warning = "#D99100",
            Error = "#E5484D",
            Info = "#3E8EF7",
            LinesDefault = "#E6E8EC",
            LinesInputs = "#D5D8DE",
            Divider = "#E6E8EC",
            DividerLight = "#EFF0F3"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7C85F5",
            Secondary = "#8B8D98",
            Tertiary = "#A78BFA",
            Background = "#0E0F11",
            BackgroundGray = "#131416",
            Surface = "#16171A",
            AppbarBackground = "#0E0F11",
            AppbarText = "#ECEDEE",
            DrawerBackground = "#0A0B0C",
            DrawerText = "#B4B6BF",
            DrawerIcon = "#8B8D98",
            TextPrimary = "#ECEDEE",
            TextSecondary = "#8B8D98",
            ActionDefault = "#8B8D98",
            Success = "#3DD68C",
            Warning = "#F5B544",
            Error = "#FF6369",
            Info = "#5EB1FF",
            LinesDefault = "#26282D",
            LinesInputs = "#34363C",
            Divider = "#26282D",
            DividerLight = "#1E2024"
        },
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft = "248px",
            AppbarHeight = "52px",
            DefaultBorderRadius = "8px"
        }
    };

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
        Api.SessionExpired += OnSessionExpired;
        Projects.Changed += OnProjectsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            // Start in the OS's light/dark preference.
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }

        if (Auth.IsAuthenticated && !Projects.Loaded && Projects.Error is null)
        {
            await Projects.EnsureLoadedAsync();
        }
    }

    private void SignOut()
    {
        Auth.SignOut();
        Projects.Clear();
        Nav.NavigateTo("/login");
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void OnProjectsChanged() => InvokeAsync(StateHasChanged);

    // The API said our token is no longer valid: go back to the login page.
    private void OnSessionExpired() => InvokeAsync(() =>
    {
        Projects.Clear();
        Nav.NavigateTo("/login");
    });

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
        Api.SessionExpired -= OnSessionExpired;
        Projects.Changed -= OnProjectsChanged;
    }
}
