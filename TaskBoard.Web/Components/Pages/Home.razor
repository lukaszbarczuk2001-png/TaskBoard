@page "/"
@implements IDisposable
@inject TaskBoardApiClient Api
@inject AuthTokenService Auth
@inject ProjectsState State
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Projects - TaskBoard</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
    <div>
        <MudText Typo="Typo.h4">Projects</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Pick a project to open its board.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateProjectAsync">
        New project
    </MudButton>
</MudStack>

@if (!State.Loaded && State.Error is null)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (State.Error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @State.Error
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="State.RefreshAsync">Retry</MudButton>
    </MudAlert>
}
else if (State.Projects.Count == 0)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center" Outlined="true" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.ViewKanban" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
        <MudText Typo="Typo.h6">No projects yet</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Create your first project to start tracking work.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateProjectAsync">New project</MudButton>
    </MudPaper>
}
else
{
    <MudGrid>
        @foreach (var project in State.Projects)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="tb-card" Outlined="true" Elevation="0">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
                            <MudAvatar Color="@UiHelpers.ColorFor(project.Key)" Variant="Variant.Filled" Rounded="true">
                                @project.Key[..1]
                            </MudAvatar>
                            <div style="min-width:0">
                                <MudText Typo="Typo.subtitle1" Class="text-truncate">@project.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@project.Key</MudText>
                            </div>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="min-height:2.5em">
                            @(string.IsNullOrWhiteSpace(project.Description) ? "No description" : project.Description)
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/projects/{project.Id}")">Board</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="@($"/projects/{project.Id}/dashboard")">Dashboard</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        State.Changed += OnStateChanged;
        await State.EnsureLoadedAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task CreateProjectAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateProjectDialog>("New project");
        var dialogResult = await dialog.Result;

        if (dialogResult is not { Canceled: false, Data: CreateProjectRequest request })
        {
            return;
        }

        var result = await Api.CreateProjectAsync(request);
        if (result.Ok)
        {
            Snackbar.Add($"Project {result.Value!.Key} created.", Severity.Success);
            await State.RefreshAsync();
        }
        else
        {
            Snackbar.Add(result.Error ?? "Could not create the project.", Severity.Error);
        }
    }

    public void Dispose() => State.Changed -= OnStateChanged;
}
